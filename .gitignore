__pycache__/
*.py[oc]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.bootstrap-venv/
*.egg-info/
build/
dist/
wheels/

# Local editor history and transient lock files can explode agent context during iterative runs.
.history/
uv.lock

/.venv/
/.venv-vllm-test/
/build_test_outputs/

# Local model storage (do not commit downloaded/cached models)
/.ollama/
/models/
/test_models/
/ollama/
/.cache/

# Compiled llama.cpp (source and build artifacts)
/llama.cpp-source/

# Local Serena notes and accidental debug exports
.serena/memories/
/subprocess
/vllm

# Debug output logs
debug_log*.txt
*.debug.log

