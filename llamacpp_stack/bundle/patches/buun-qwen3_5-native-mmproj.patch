 constexpr const char * QWEN4_VISUAL_PREFIX = "model.visual.";
 
+// HF `model_type` values whose checkpoints carry the vision tower under
+// `model.visual.` in the Qwen3-VL merger layout add_source() expects:
+// qwen4_exp = Qwen3.8-Flash-Next, qwen3_5 = Qwen3.5/3.8 (e.g. Qwen3.8-27B-EXL3).
+constexpr const char * QWEN_VISION_MODEL_TYPES[] = { "qwen4_exp", "qwen3_5" };
+
+bool is_supported_vision_model_type(const std::string & model_type) {
+    for (const char * candidate : QWEN_VISION_MODEL_TYPES) {
+        if (model_type == candidate) {
+            return true;
+        }
+    }
+    return false;
+}
